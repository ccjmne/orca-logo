{
  "compileOnSave": true,
  "compilerOptions": {
    "incremental": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "importHelpers": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "es6",
    "preserveConstEnums": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "lib": ["DOM", "ESNext"]
  },
  "exclude": ["node_modules", "dist", "src/blank.vert", "src/*.frag"]
}
